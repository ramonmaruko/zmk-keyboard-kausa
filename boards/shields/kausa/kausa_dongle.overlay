#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,matrix-input = &mock_matrix_input;
	/* zmk,physical-layout = &physical_layout0; */
    };

    mock_matrix_input: mock_matrix_input {
        compatible = "zmk,input-matrix-mock";
	columns = <0>;
	rows = <0>;
	events = <0>;
    };


	default_transform: keymap_transform0 {
		compatible = "zmk,matrix-transform";
		rows = <4>;
		columns = <14>;

		map = <RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5) RC(0, 12) RC(0, 11)
		       RC(0, 10) RC(0, 9) RC(0, 8) RC(0, 7) RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3)
		       RC(1, 4) RC(1, 5) RC(1, 12) RC(1, 11) RC(1, 10) RC(1, 9) RC(1, 8) RC(1, 7)
		       RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 12) RC(2, 11)
		       RC(2, 10) RC(2, 9) RC(2, 8) RC(2, 7) RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3)
		       RC(3, 4) RC(3, 5) RC(3, 12) RC(3, 11) RC(3, 10) RC(3, 9) RC(3, 8) RC(3, 7)
		       RC(0, 6) RC(1, 6) RC(2, 6) RC(2, 13) RC(1, 13) RC(0, 13)>;
	};

	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Default Layout";
		transform = <&default_transform>;
		keys  //                     w   h    x    y     rot    rx    ry
		    = <&key_physical_attrs 100 100    0  114  (-400)    50   164>
		    , <&key_physical_attrs 100 100  100  104  (-400)   150   154>
		    , <&key_physical_attrs 100 100  207   19  (-200)   257    69>
		    , <&key_physical_attrs 100 100  306    0  (-200)   356    50>
		    , <&key_physical_attrs 100 100  421   74       0     0     0>
		    , <&key_physical_attrs 100 100  522   90       0     0     0>
		    , <&key_physical_attrs 100 100  442  491       0     0     0>
		    , <&key_physical_attrs 100 100 1657  114     400  1707   164>
		    , <&key_physical_attrs 100 100 1558  104     400  1608   154>
		    , <&key_physical_attrs 100 100 1451   19     200  1501    69>
		    , <&key_physical_attrs 100 100 1351    0     200  1401    50>
		    , <&key_physical_attrs 100 100 1236   74       0     0     0>
		    , <&key_physical_attrs 100 100 1136   90       0     0     0>
