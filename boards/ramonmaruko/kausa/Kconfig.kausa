config BOARD_KAUSA
	select SOC_NRF54L15_CPUAPP if BOARD_KAUSA_NRF54L15_CPUAPP || \
		BOARD_KAUSA_NRF54L15_CPUAPP_LEFT || \
		BOARD_KAUSA_NRF54L15_CPUAPP_RIGHT || \
		BOARD_KAUSA_NRF54L15_CPUAPP_NS
	select SOC_NRF54L15_CPUFLPR if BOARD_KAUSA_NRF54L15_CPUFLPR || \
					    BOARD_KAUSA_NRF54L15_CPUFLPR_XIP
