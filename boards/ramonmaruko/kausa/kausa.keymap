#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
				&kp TILDE &kp N1 &kp N2 &kp N3   &kp N4    &kp N5	&kp N6   &kp N7  &kp N8       &kp N9     &kp N0    &kp MINUS
				&kp TILDE &kp Q  &kp W  &kp E    &kp R     &kp T	&kp Y    &kp U   &kp I        &kp O      &kp P     &kp BSLH
				&kp PG_UP &kp A  &kp S  &kp D    &kp F     &kp G	&kp H    &kp J   &kp K        &kp L      &kp SEMI  &kp SQT
				&kp PG_DN &kp Z  &kp X  &kp C    &kp V     &kp B	&kp N    &kp M   &kp KP_COMMA &kp KP_DOT &kp SLASH &kp BSLH
				                        &kp &none &kp SPACE &kp LGUI	&kp LGUI &kp RET &kp &none
			>;
		};
	};
};
