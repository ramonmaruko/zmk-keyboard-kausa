CONFIG_INPUT=y
CONFIG_INPUT_SHELL=y
CONFIG_INPUT_SHELL_KBD_MATRIX_STATE=y
#CONFIG_INPUT_LOG_LEVEL_DBG=y

# Enable UART driver
CONFIG_SERIAL=y

# Enable GPIO
CONFIG_GPIO=y
CONFIG_GPIO_SHELL=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_UART_CONSOLE=n

CONFIG_SHELL=y
CONFIG_SHELL_BACKEND_RTT=y
CONFIG_SHELL_BACKEND_SERIAL=n

CONFIG_LOG=y
CONFIG_LOG_BUFFER_SIZE=10240
# CONFIG_LOG_BACKEND_RTT=y

CONFIG_REGULATOR=y
CONFIG_REGULATOR_SHELL=y

CONFIG_I2C_SHELL=y
CONFIG_I2C_LOG_LEVEL_DBG=y
