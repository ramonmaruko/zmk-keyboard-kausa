if BOARD_KAUSA_LEFT

config ZMK_KEYBOARD_NAME
    default "Kausa"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_KAUSA_LEFT


if BOARD_KAUSA_LEFT || BOARD_KAUSA_RIGHT

config BOARD
    default "kausa"

config ZMK_SPLIT
    default y


config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

if SPI_NOR

config SPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096 if MCUBOOT || BOOTLOADER_MCUBOOT

endif # SPI_NOR

endif # BOARD_KAUSA_LEFT || BOARD_KAUSA_RIGHT
